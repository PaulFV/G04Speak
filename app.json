{
  "expo": {
    "name": "G04Speak",
    "slug": "gospeak",
    "description": "Lerne acht Sprachen kostenlos, spielerisch und ohne Konto.",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/gospeak-space-icon.png",
    "scheme": "gospeak",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gospeak-space-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#090B3D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gospeak.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/gospeak-space-mark.png",
        "backgroundColor": "#090B3D"
      },
      "package": "com.gospeak.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/gospeak-space-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B3D",
          "image": "./assets/gospeak-space-mark.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "G04Speak braucht Zugriff auf deine Fotos, um ein Profilbild zu setzen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/gospeak-space-icon.png",
          "color": "#090B3D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/G04Speak"
    }
  }
}
